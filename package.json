{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20 || 22"
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "start:backend:env": "dotenv -e .env yarn workspace backend start",
    "start:env": "bash -c 'set -a && source .env && set +a && yarn start'",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/master",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "devDependencies": {
    "@backstage/cli": "^0.34.3",
    "@backstage/e2e-test-utils": "^0.1.1",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "^10.0.0",
    "node-gyp": "^11.4.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "resolutions": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@backstage/core-app-api/react": "^18.2.0",
    "@backstage/core-plugin-api/react": "^18.2.0",
    "@backstage/core-components/react": "^18.2.0"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.4.1",
  "dependencies": {
    "@backstage-community/plugin-badges": "^0.11.1",
    "@backstage-community/plugin-github-actions": "^0.14.0",
    "@backstage-community/plugin-todo": "^0.12.0",
    "@backstage/plugin-kubernetes": "^0.12.11",
    "@backstage/plugin-techdocs": "^1.15.0",
    "@backstage/plugin-techdocs-react": "^1.3.3",
    "@backstage/plugin-user-settings": "^0.8.26",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@material-ui/lab": "^4.0.0-alpha.61",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "backstage-plugin-techdocs-addon-mermaid": "^0.24.0",
    "chart.js": "^4.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.1",
    "react-router-dom": "^7.9.1",
    "react-use": "^17.6.0",
    "recharts": "^3.2.1"
  }
}
